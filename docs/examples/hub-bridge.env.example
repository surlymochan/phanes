# SSH 模式：Hub、bridge 和 swrm-fleet 都运行在 box 上。
# 本文件只包含部署占位值；请按 box 上的实际路径替换 CLI 路径。

OPENSWARM_AUTO_CLI=/absolute/path/to/swrm-fleet
OPENSWARM_AUTO_LOCAL_HOST=local

# 当前 fleet 拓扑：node-1.example.invalid 有 2 个 lane，其余主机各有 1 个，共 10 个 lane。
# 不纳入 local、worker 或 copilot。
OPENSWARM_AUTO_FLEET_HOSTS='["node-1.example.invalid","node-2.example.invalid","node-3.example.invalid","node-4.example.invalid","node-5.example.invalid","broker","relay.example.invalid","worker-a.example.invalid","worker-b.example.invalid"]'
OPENSWARM_AUTO_HOST_BACKENDS='{"local":[],"node-1.example.invalid":["pi"],"node-2.example.invalid":["pi"],"node-3.example.invalid":["pi"],"node-4.example.invalid":["pi"],"node-5.example.invalid":["pi"],"broker":["agy"],"relay.example.invalid":["codex"],"worker-a.example.invalid":["codex"],"worker-b.example.invalid":["codex"]}'
