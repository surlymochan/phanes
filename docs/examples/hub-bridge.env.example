# SSH 模式：Hub、bridge 和 swrm-fleet 都运行在 box 上。
# 本文件只包含部署占位值；请按 box 上的实际路径替换 CLI 路径。

OPENSWARM_AUTO_CLI=/absolute/path/to/swrm-fleet

# 2026-11-02 基线：控制面本机是 box，不是受控 fleet host；
# 受控远端主机为 worker、gores2、worker-a.example.invalid、relay.example.invalid、broker。
OPENSWARM_AUTO_LOCAL_HOST=box

# 当前 fleet 拓扑共 10 个 lane：worker 3、gores2 2、worker-a.example.invalid 2、
# relay.example.invalid 2、broker 1；限额见 docs/fleet-topology-expected.md。
# box 的空白名单确保本机 lane 不被探测或接收自动派发，其余主机按 backend 白名单派发。
OPENSWARM_AUTO_FLEET_HOSTS='["worker","gores2","worker-a.example.invalid","relay.example.invalid","broker"]'
OPENSWARM_AUTO_HOST_BACKENDS='{"box":[],"worker":["pi"],"gores2":["pi"],"worker-a.example.invalid":["codex"],"relay.example.invalid":["codex"],"broker":["agy"]}'
