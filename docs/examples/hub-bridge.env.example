# SSH 模式：Hub、bridge 和 swrm-fleet 都运行在 box 上。
# 本文件只包含部署占位值；请按 box 上的实际路径替换 CLI 路径。

OPENSWARM_AUTO_CLI=/absolute/path/to/swrm-fleet
# bridge 直接使用本机 fleet inventory；不经过旧 SSH gateway。
OPENSWARM_HUB_LOCAL_ROUTER=1

# 2026-11-02 基线：控制面本机是 box，不是受控 fleet host；
# 受控远端主机为 gores1、gores2、govpn、govpn2、gorelay、gocc。
OPENSWARM_AUTO_LOCAL_HOST=box

# 当前 fleet 拓扑共 11 个 lane：gores1 3、gores2 2、govpn 1、govpn2 1、
# gorelay 2、gocc 2；限额见 docs/fleet-topology-expected.md。
# box 的空白名单确保本机 lane 不被探测或接收自动派发，其余主机按 backend 白名单派发。
OPENSWARM_AUTO_FLEET_HOSTS='["gores1","gores2","govpn","govpn2","gorelay","gocc"]'
OPENSWARM_AUTO_HOST_BACKENDS='{"box":[],"gores1":["pi"],"gores2":["pi"],"govpn":["codex"],"govpn2":["codex"],"gorelay":["codex"],"gocc":["agy"]}'
