# SSH 模式：Hub、bridge 和 openswarm-fleet 都运行在 box 上。
# 本文件只包含部署占位值；请按 box 上的实际路径替换 CLI 路径。

OPENSWARM_AUTO_CLI=/absolute/path/to/openswarm-fleet
OPENSWARM_AUTO_LOCAL_HOST=local

# 当前 fleet 拓扑：ib1 有 2 个 lane，其余主机各有 1 个，共 10 个 lane。
# 不纳入 local、gores1 或 copilot。
OPENSWARM_AUTO_FLEET_HOSTS='["ib1","ib2","ib3","ib4","ib5","gocc","gorelay","govpn","govpn2"]'
OPENSWARM_AUTO_HOST_BACKENDS='{"local":[],"ib1":["pi"],"ib2":["pi"],"ib3":["pi"],"ib4":["pi"],"ib5":["pi"],"gocc":["agy"],"gorelay":["codex"],"govpn":["codex"],"govpn2":["codex"]}'
