# SSH 模式：Hub、bridge 和 openswarm-fleet 都运行在 box 上。
# 本文件只包含部署占位值；请按 box 上的实际路径替换 CLI 路径。

OPENSWARM_AUTO_CLI=/absolute/path/to/openswarm-fleet
OPENSWARM_AUTO_LOCAL_HOST=box

# box 仅为控制面本机；空白名单确保本地 lane 不被探测或派发。
OPENSWARM_AUTO_FLEET_HOSTS='["gores1","gores2","gocc","gorelay","govpn","govpn2"]'
OPENSWARM_AUTO_HOST_BACKENDS='{"box":[],"gores1":["pi"],"gores2":["pi"],"gocc":["agy"],"gorelay":["agy"],"govpn":["codex"],"govpn2":["codex"]}'
