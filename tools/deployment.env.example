# Placeholder values only. Copy to .deployment.env, edit locally, then source it.
export PHANES_PUBLISH_HOST=publish.example.invalid
export PHANES_LOCAL_REPO=/path/to/local/repo
export PHANES_REMOTE_REPO=/path/to/remote/repo
export PHANES_REMOTE_WORKTREE=/path/to/new/remote/worktree
export PHANES_DEPS_SCRIPT=/path/to/local-deps-script
export PHANES_DEPS_SOURCE=/path/to/dependency/source
export PHANES_PATCH_DIR=/path/to/private/patches
export PHANES_SCRATCH_DIR=/path/to/local/transfers
export PHANES_WORKTREE_ROOT=/path/to/worktrees
# Optional: defaults to the repository resolved in PHANES_LOCAL_REPO.
# export PHANES_PR_REPO=example/project
export SWRM_BROKER_HOST=broker.example.invalid
export SWRM_WORKER_HOST=worker.example.invalid
export OPENSWARM_AUTO_SSH_HOST=gateway.example.invalid
# Existing deployments can preserve their state without automatic migration:
# export OPENSWARM_HOME=/path/to/existing/state
