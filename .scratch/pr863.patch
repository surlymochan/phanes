+def certificate_module():
+    """The shared fleet certificate rules, loaded next to this script.
+
+    The `fleet-capacity` admission gate reads the same module, so one host is
+    judged the same way by `fleet status`, `fleet exec` and the gate.
+    """
+    module = sys.modules.get("fleet_certificate")
+    if module is not None:
+        return module
+    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "fleet_certificate.py")
+    spec = importlib.util.spec_from_file_location("fleet_certificate", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load fleet certificate helper from {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def fleet_certificate_command(host):
+    """The certificate command of one fleet host, or None when it has none."""
+    prefix = fleet_ssh_argv(host) if host.get("kind") == "ssh" else None
+    return certificate_module().renew_command(host["name"], host=host, ssh_prefix=prefix)
+
+
+def fleet_certificate_status(host, timeout=20):
+    """Renew and check the certificate of one fleet host.
+
+    Returns (ok, error): a failed renewal, a missing expiry and an expiry in
+    the past all leave the host without a usable certificate.
+    """
+    return certificate_module().certificate_status(fleet_certificate_command(host), timeout=timeout)
+
+
