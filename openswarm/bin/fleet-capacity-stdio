#!/usr/bin/env python3
"""Expose one fixed-caller fleet coordinator over a local Unix socket.

Run this on gocc once per remote executor host.  The socket is intended to be
the local end of an SSH reverse StreamLocal forward; the remote machine uses
fleet-capacity-socket-client as its normal fleet guard command.
"""
import argparse
import json
import os
from pathlib import Path
import socket
import stat
import subprocess
import sys
import threading

MAX_REQUEST_BYTES = 64 * 1024


def receive(connection):
    data = bytearray()
    while b'\n' not in data and len(data) <= MAX_REQUEST_BYTES:
        chunk = connection.recv(min(4096, MAX_REQUEST_BYTES + 1 - len(data)))
        if not chunk:
            break
        data.extend(chunk)
    if len(data) > MAX_REQUEST_BYTES or not data.endswith(b'\n'):
        raise ValueError('invalid coordinator request')
    request = json.loads(data.decode('utf-8'))
    if not isinstance(request, dict):
        raise ValueError('invalid coordinator request')
    return request


def response(coordinator, caller, request):
    result = subprocess.run([coordinator, caller], input=json.dumps(request), text=True,
                            capture_output=True, timeout=20)
    try:
        answer = json.loads(result.stdout)
    except ValueError as error:
        raise ValueError('coordinator returned invalid JSON') from error
    if not isinstance(answer, dict):
        raise ValueError('coordinator returned invalid JSON')
    return answer


def serve_connection(connection, coordinator, caller):
    with connection:
        try:
            answer = response(coordinator, caller, receive(connection))
        except (OSError, ValueError, UnicodeDecodeError, json.JSONDecodeError, subprocess.TimeoutExpired) as error:
            answer = {'ok': False, 'error': f'coordinator unavailable: {error}'}
        connection.sendall((json.dumps(answer, separators=(',', ':')) + '\n').encode('utf-8'))


def remove_stale_socket(socket_path):
    """Remove only a dead Unix socket left by an interrupted prior service."""
    try:
        mode = socket_path.stat().st_mode
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(mode):
        raise RuntimeError('coordinator socket path is not a socket')
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.settimeout(0.5)
        probe.connect(str(socket_path))
    except ConnectionRefusedError:
        socket_path.unlink()
    finally:
        probe.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--socket', required=True)
    parser.add_argument('--caller', required=True, choices=('gocc', 'gores1', 'govpn', 'govpn2', 'local'))
    parser.add_argument('--coordinator', default=str(Path(__file__).with_name('fleet-capacity')))
    args = parser.parse_args()
    socket_path = Path(args.socket)
    socket_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    remove_stale_socket(socket_path)
    old_mask = os.umask(0o077)
    try:
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(str(socket_path))
    finally:
        os.umask(old_mask)
    listener.listen(16)
    try:
        while True:
            connection, _ = listener.accept()
            threading.Thread(target=serve_connection, args=(connection, args.coordinator, args.caller),
                             daemon=True).start()
    finally:
        listener.close()
        try:
            socket_path.unlink()
        except FileNotFoundError:
            pass


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        print(f'fleet-capacity-stdio: {error}', file=sys.stderr)
        sys.exit(1)
