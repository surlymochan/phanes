#!/usr/bin/env python3
"""Choose an available production lane from task type and difficulty."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

home = Path.home()
cli = os.environ.get('OPENSWARM_AUTO_CLI', str(home / '.local/bin/openswarm'))
ssh = ['/usr/bin/ssh', '-T', '-F', str(home / '.ssh/openswarm-fleet/config'), 'openswarm-pi-broker']

class LaneBusy(RuntimeError):
    pass

def remote(payload):
    p = subprocess.run(ssh, input=json.dumps(payload), capture_output=True, text=True, timeout=35)
    try: result = json.loads(p.stdout)
    except ValueError: raise RuntimeError('gocc dispatch gateway unavailable')
    if p.returncode or not result.get('ok'):
        reply = result.get('result')
        if (payload.get('op') == 'assign' and isinstance(reply, dict) and reply.get('ok') is False
                and reply.get('error') == f"lane {payload.get('lane')} is busy (busy)"):
            raise LaneBusy('remote lane is busy')
        raise RuntimeError('gocc dispatch gateway rejected request')
    return result['result']

def local_lanes():
    p = subprocess.run([cli, 'lane', 'status'], capture_output=True, text=True, timeout=15)
    if p.returncode: raise RuntimeError('local lane status unavailable')
    return json.loads(p.stdout)

def fleet_hosts():
    """Return configured existing fleet hosts, never task-supplied endpoints."""
    raw = os.environ.get('OPENSWARM_AUTO_FLEET_HOSTS')
    if raw is None:
        return []
    try:
        hosts = json.loads(raw)
    except ValueError as error:
        raise RuntimeError('invalid automatic routing fleet host configuration') from error
    if (not isinstance(hosts, list) or not hosts
            or any(not isinstance(host, str) or not re.fullmatch(r'[A-Za-z0-9_.-]{1,80}', host)
                   or host == 'local' for host in hosts)
            or len(set(hosts)) != len(hosts)):
        raise RuntimeError('invalid automatic routing fleet host configuration')
    return hosts

def backend_filters(hosts):
    """Optional administrator-owned backend allowlists for each fleet host."""
    raw = os.environ.get('OPENSWARM_AUTO_HOST_BACKENDS')
    if raw is None:
        return {}
    try:
        filters = json.loads(raw)
    except ValueError as error:
        raise RuntimeError('invalid automatic routing backend configuration') from error
    allowed_hosts = {local_host(), *hosts}
    if (not isinstance(filters, dict) or not filters
            or any(not isinstance(host, str) or host not in allowed_hosts
                   or not isinstance(backends, list)
                   or any(not isinstance(backend, str) or not re.fullmatch(r'[a-z][a-z0-9-]{0,39}', backend)
                          for backend in backends)
                   for host, backends in filters.items())):
        raise RuntimeError('invalid automatic routing backend configuration')
    return {host: set(backends) for host, backends in filters.items()}

def fleet_lanes(host):
    process = subprocess.run([cli, 'fleet', 'exec', host, '--', 'lane', 'status'],
                             capture_output=True, text=True, timeout=35)
    try:
        rows = json.loads(process.stdout)
    except ValueError as error:
        raise RuntimeError('fleet lane status unavailable') from error
    if process.returncode or not isinstance(rows, list):
        raise RuntimeError('fleet lane status unavailable')
    return rows

def fleet_assign(host, lane, prompt, base, title, verify, budget, read_only):
    command = [cli, 'fleet', 'exec', host, '--', 'lane', 'assign', lane,
               '--prompt', prompt, '--base', base, '--budget-minutes', str(budget)]
    if title:
        command += ['--title', title]
    if verify:
        command += ['--verify', verify]
    if read_only:
        command.append('--read-only')
    process = subprocess.run(command, capture_output=True, text=True, timeout=45)
    try:
        response = json.loads(process.stdout)
    except ValueError as error:
        raise RuntimeError('fleet dispatch acknowledgement unavailable') from error
    if response.get('ok') is False and response.get('error') == f'lane {lane} is busy (busy)':
        raise LaneBusy('fleet lane is busy')
    if process.returncode or not isinstance(response, dict) or not response.get('id'):
        raise RuntimeError('fleet dispatch acknowledgement unavailable')
    return response

def local_host():
    host = os.environ.get('OPENSWARM_AUTO_LOCAL_HOST', 'gores1')
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,80}', host):
        raise RuntimeError('invalid automatic routing local host configuration')
    return host

def preference(kind, difficulty):
    if kind == 'migration':
        return ['agy', 'cursor', 'pi', 'copilot', 'codex']
    if difficulty >= 5:
        return ['agy', 'cursor', 'pi', 'copilot', 'codex']
    if difficulty >= 4:
        return ['agy', 'cursor', 'pi', 'copilot', 'codex']
    if kind in ('test', 'refactor', 'debug'):
        return ['cursor', 'pi', 'agy', 'copilot', 'codex']
    if kind in ('mechanical', 'format', 'rename', 'docs') and difficulty <= 2:
        return ['pi', 'cursor', 'agy', 'copilot', 'codex']
    if difficulty <= 2:
        return ['pi', 'cursor', 'agy', 'copilot', 'codex']
    return ['pi', 'cursor', 'agy', 'copilot', 'codex']

def discovered_lanes():
    hosts = fleet_hosts()
    filters = backend_filters(hosts)
    local_allowed = filters.get(local_host())
    # An explicit empty local allowlist makes this a Hub-only router.  Do not
    # probe a local lane runtime or require its lanes.json in that layout.
    rows = [] if local_allowed == set() else [
        {**row, '_origin': 'local'} for row in local_lanes()
        if local_allowed is None or row.get('backend') in local_allowed
    ]
    if hosts:
        unavailable = []
        for host in hosts:
            try:
                allowed = filters.get(host)
                rows.extend({**row, '_origin': 'fleet', '_fleet_host': host} for row in fleet_lanes(host)
                            if allowed is None or row.get('backend') in allowed)
            except (RuntimeError, OSError, subprocess.SubprocessError):
                unavailable.append(host)
        # A partial outage may still leave a usable host, but silently turning
        # a total fleet-discovery outage into "no available lane" hides the
        # operational distinction from the Hub handoff journal.
        if len(unavailable) == len(hosts):
            raise RuntimeError('fleet lane discovery unavailable: ' + ','.join(unavailable))
        return rows
    try:
        rows.extend({**row, '_origin': 'remote'} for row in remote({'op':'lanes'}))
    except (RuntimeError, OSError, subprocess.SubprocessError):
        pass
    return rows

def available_in_preference(lanes, backends, kind, difficulty):
    idle = [row for row in lanes if row.get('state') == 'idle']
    ordered = []
    for backend in backends:
        candidates = [row for row in idle if row.get('backend') == backend]
        # The high-difficulty Copilot contract is intentionally strict: GH2's
        # Sonnet lane may be busy, but that must not silently turn a difficult
        # task into a Haiku run.  Let a later backend be considered instead.
        if backend == 'copilot' and difficulty >= 4:
            candidates = [row for row in candidates if 'sonnet' in str(row.get('model') or '').lower()]
        def lane_key(row):
            model = str(row.get('model') or '').lower()
            if backend == 'copilot':
                preferred = 'sonnet' if difficulty >= 4 else 'haiku'
                model_rank = 0 if preferred in model else 1
            else:
                model_rank = 0
            return (model_rank, row.get('name', ''), row.get('_origin', ''), row.get('_fleet_host', ''))
        ordered.extend(sorted(candidates, key=lane_key))
    return ordered

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--type', default='impl', choices=['impl','mechanical','format','rename','docs','test','refactor','debug','migration','review','research','audit','second-opinion'])
    p.add_argument('--difficulty', type=int, choices=range(1,6), default=3)
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument('--prompt')
    g.add_argument('--task-file')
    p.add_argument('--title')
    p.add_argument('--verify')
    p.add_argument('--base')
    p.add_argument('--budget-minutes', type=float, default=15)
    p.add_argument('--dry-run', action='store_true')
    args = p.parse_args()
    prompt = args.prompt if args.prompt is not None else Path(args.task_file).read_text()
    if not prompt.strip() or len(prompt)>50000 or not 0 < args.budget_minutes <= 40:
        raise ValueError('invalid prompt or budget')
    repo = home / 'work/openbot-executor-base'
    base = args.base or subprocess.check_output(['git','-C',str(repo),'rev-parse','HEAD'], text=True).strip()
    if not base or len(base)>100 or any(c not in '0123456789abcdef' for c in base):
        raise ValueError('base must be a hexadecimal commit')
    read_only = args.type in ('review', 'research', 'audit', 'second-opinion')
    lanes = discovered_lanes()
    ordered = available_in_preference(lanes, preference(args.type,args.difficulty), args.type, args.difficulty)
    if not ordered:
        raise RuntimeError('no available fleet lane')
    for row in ordered:
        lane = row['name']
        local = row['_origin'] == 'local'
        fleet = row['_origin'] == 'fleet'
        result = {'ok': True, 'lane': lane, 'backend': row['backend'], 'model': row['model'],
                  'host': local_host() if local else (row['_fleet_host'] if fleet else 'gocc'),
                  'profile': {'type': args.type, 'difficulty': args.difficulty}}
        if read_only: result['read_only'] = True
        if local and row['backend'] == 'pi' and read_only:
            result['lane'] = None
            result['execution_mode'] = 'one-shot'
        if args.dry_run:
            print(json.dumps(result)); return
        if local and row['backend'] == 'pi' and read_only:
            command = [cli, 'run', '--type', 'review', '--backend', 'pi', '--read-only', '--no-fallback',
                       '--cwd', str(repo), '--base', base, '--prompt', prompt, '--detach',
                       '--budget-minutes', str(args.budget_minutes)]
            if args.title: command += ['--title', args.title]
            if args.verify: command += ['--verify', args.verify]
            proc = subprocess.run(command, capture_output=True, text=True, timeout=30)
            try: response = json.loads(proc.stdout)
            except ValueError: raise RuntimeError('local dispatch acknowledgement unavailable')
            if proc.returncode or not response.get('id'):
                raise RuntimeError('local dispatch acknowledgement unavailable')
        elif local:
            command = [cli,'lane','assign',lane,'--prompt',prompt,'--base',base,
                       '--budget-minutes',str(args.budget_minutes)]
            if args.title: command += ['--title', args.title]
            if args.verify: command += ['--verify',args.verify]
            if read_only: command.append('--read-only')
            proc = subprocess.run(command, capture_output=True, text=True, timeout=30)
            try: response = json.loads(proc.stdout)
            except ValueError: raise RuntimeError('local dispatch acknowledgement unavailable')
            if response.get('ok') is False:
                if response.get('error') == f'lane {lane} is busy (busy)':
                    continue
                raise RuntimeError('local dispatch acknowledgement unavailable')
            if proc.returncode or not response.get('id'):
                raise RuntimeError('local dispatch acknowledgement unavailable')
        elif fleet:
            try:
                response = fleet_assign(row['_fleet_host'], lane, prompt, base, args.title, args.verify,
                                        args.budget_minutes, read_only)
            except LaneBusy:
                continue
        else:
            try:
                response = remote({'op':'assign','lane':lane,'prompt':prompt,'base':base,
                                   'title':args.title,'verify':args.verify,'budget_minutes':args.budget_minutes,
                                   'read_only':read_only})
            except LaneBusy:
                continue
        result.update({'id':response['id'], 'state':response['state']})
        print(json.dumps(result)); return
    raise RuntimeError('available lanes changed or rejected the task')

if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as e:
        print(json.dumps({'ok':False,'error':str(e)})); sys.exit(1)
