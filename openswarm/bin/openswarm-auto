#!/usr/bin/env python3
"""Choose an available production lane from task type and difficulty."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

home = Path.home()
cli = str(home / '.local/bin/openswarm')
ssh = ['/usr/bin/ssh', '-T', '-F', str(home / '.ssh/openswarm-fleet/config'), 'openswarm-pi-broker']
DEFAULT_REMOTE_SOURCE = {'host': 'gocc', 'ssh_alias': 'openswarm-pi-broker'}

class LaneBusy(RuntimeError):
    pass

def remote_sources():
    """Read the explicit trusted gateway list for automatic fleet routing.

    The legacy single gocc endpoint remains the default.  New executor hosts
    are opt-in through a bounded list of SSH aliases already constrained by
    the local SSH configuration; the task payload never chooses an endpoint.
    """
    raw = os.environ.get('OPENSWARM_AUTO_REMOTE_SOURCES')
    if raw is None:
        return [DEFAULT_REMOTE_SOURCE]
    try:
        sources = json.loads(raw)
    except ValueError as error:
        raise RuntimeError('invalid automatic routing remote source configuration') from error
    if not isinstance(sources, list) or not sources:
        raise RuntimeError('invalid automatic routing remote source configuration')
    # Keep the legacy gocc route even after extra hosts are configured.  Hub
    # handoff rows persist their executor host and old rows must remain
    # queryable after a fleet expansion.
    validated = [DEFAULT_REMOTE_SOURCE]
    seen = {'gocc'}
    for source in sources:
        if not isinstance(source, dict):
            raise RuntimeError('invalid automatic routing remote source configuration')
        host, alias, via = source.get('host'), source.get('ssh_alias'), source.get('via')
        if (not isinstance(host, str) or not isinstance(alias, str)
                or not re.fullmatch(r'[A-Za-z0-9_.-]{1,80}', host)
                or not re.fullmatch(r'[A-Za-z0-9_.-]{1,80}', alias)):
            raise RuntimeError('invalid automatic routing remote source configuration')
        if host == 'gocc':
            if alias != DEFAULT_REMOTE_SOURCE['ssh_alias'] or via is not None:
                raise RuntimeError('conflicting automatic routing remote source configuration')
            continue
        if via not in (None, 'gocc'):
            raise RuntimeError('invalid automatic routing remote source configuration')
        if host == 'gores1' or host in seen:
            raise RuntimeError('conflicting automatic routing remote source configuration')
        seen.add(host)
        item = {'host': host, 'ssh_alias': alias}
        if via:
            item['via'] = via
        validated.append(item)
    return validated

def remote_from(source, payload):
    command = [*ssh[:-1], source['ssh_alias']]
    # A relay source is deliberately addressed through the existing Hub-side
    # transport.  The outer process never receives an arbitrary SSH alias:
    # the relay maps this logical target to its own fixed target inventory.
    request = ({'op': 'relay', 'target': source['host'], 'request': payload}
               if source.get('via') == 'gocc' else payload)
    p = subprocess.run(command, input=json.dumps(request), capture_output=True, text=True, timeout=35)
    try: result = json.loads(p.stdout)
    except ValueError: raise RuntimeError('gocc dispatch gateway unavailable')
    if p.returncode or not result.get('ok'):
        reply = result.get('result')
        if (payload.get('op') == 'assign' and isinstance(reply, dict) and reply.get('ok') is False
                and reply.get('error') == f"lane {payload.get('lane')} is busy (busy)"):
            raise LaneBusy('remote lane is busy')
        raise RuntimeError('gocc dispatch gateway rejected request')
    return result['result']

def remote(payload):
    """Compatibility wrapper for the legacy gocc gateway and its tests."""
    return remote_from(DEFAULT_REMOTE_SOURCE, payload)

def local_lanes():
    p = subprocess.run([cli, 'lane', 'status'], capture_output=True, text=True, timeout=15)
    if p.returncode: raise RuntimeError('local lane status unavailable')
    return json.loads(p.stdout)

def preference(kind, difficulty):
    """Return backend preference, not a fixed lane inventory.

    The fleet grows by adding lanes.  Routing must therefore select an idle
    lane by backend rather than silently retaining the original one-lane names.
    Capacity admission remains the source of truth for each backend and the
    total fleet cap.
    """
    if kind == 'migration':
        return ['agy', 'cursor', 'pi', 'copilot', 'codex'] if difficulty >= 4 else ['agy', 'pi', 'cursor', 'copilot', 'codex']
    if difficulty >= 5:
        return ['agy', 'cursor', 'pi', 'copilot', 'codex']
    if difficulty >= 4:
        return ['agy', 'cursor', 'pi', 'copilot', 'codex']
    if kind in ('test', 'refactor', 'debug'):
        return ['cursor', 'pi', 'agy', 'copilot', 'codex']
    if kind in ('mechanical', 'format', 'rename', 'docs') and difficulty <= 2:
        return ['pi', 'cursor', 'agy', 'copilot', 'codex']
    if difficulty <= 2:
        return ['pi', 'cursor', 'agy', 'copilot', 'codex']
    return ['pi', 'cursor', 'agy', 'copilot', 'codex']

def discovered_lanes():
    """Keep the dispatch origin with every lane, including duplicate names."""
    rows = []
    for row in local_lanes():
        rows.append({**row, '_origin': 'local'})
    for source in remote_sources():
        try:
            request = {'op':'lanes'}
            result = remote(request) if source == DEFAULT_REMOTE_SOURCE else remote_from(source, request)
            for row in result:
                rows.append({**row, '_origin': 'remote', '_remote_source': source})
        except (RuntimeError, OSError, subprocess.SubprocessError):
            pass
    return rows

def available_in_preference(lanes, backends):
    """Return every idle matching lane in deterministic backend/name order."""
    idle = [row for row in lanes if row.get('state') == 'idle']
    ordered = []
    for backend in backends:
        matches = [row for row in idle if row.get('backend') == backend]
        ordered.extend(sorted(matches, key=lambda row: (row.get('name', ''), row.get('_origin', ''))))
    return ordered

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--type', default='impl', choices=['impl','mechanical','format','rename','docs','test','refactor','debug','migration','review','research','audit','second-opinion'])
    p.add_argument('--difficulty', type=int, choices=range(1,6), default=3)
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument('--prompt')
    g.add_argument('--task-file')
    p.add_argument('--title')
    p.add_argument('--verify')
    p.add_argument('--base')
    p.add_argument('--budget-minutes', type=float, default=15)
    p.add_argument('--dry-run', action='store_true')
    args = p.parse_args()
    prompt = args.prompt if args.prompt is not None else Path(args.task_file).read_text()
    if not prompt.strip() or len(prompt)>50000 or not 0 < args.budget_minutes <= 40:
        raise ValueError('invalid prompt or budget')
    repo = home / 'work/openbot-executor-base'
    base = args.base or subprocess.check_output(['git','-C',str(repo),'rev-parse','HEAD'], text=True).strip()
    if not base or len(base)>100 or any(c not in '0123456789abcdef' for c in base):
        raise ValueError('base must be a hexadecimal commit')
    read_only = args.type in ('review', 'research', 'audit', 'second-opinion')
    lanes = discovered_lanes()
    ordered = available_in_preference(lanes, preference(args.type,args.difficulty))
    if not ordered:
        raise RuntimeError('no available fleet lane')
    for row in ordered:
        lane = row['name']
        local = row['_origin'] == 'local'
        result = {'ok': True, 'lane': lane, 'backend': row['backend'], 'model': row['model'],
                  'host': 'gores1' if local else row['_remote_source']['host'],
                  'profile': {'type': args.type, 'difficulty': args.difficulty}}
        if read_only: result['read_only'] = True
        if local and row['backend'] == 'pi' and read_only:
            result['lane'] = None
            result['execution_mode'] = 'one-shot'
        if args.dry_run:
            print(json.dumps(result)); return
        if local and row['backend'] == 'pi' and read_only:
            command = [cli, 'run', '--type', 'review', '--backend', 'pi', '--read-only', '--no-fallback',
                       '--cwd', str(repo), '--base', base, '--prompt', prompt, '--detach',
                       '--budget-minutes', str(args.budget_minutes)]
            if args.title: command += ['--title', args.title]
            if args.verify: command += ['--verify', args.verify]
            proc = subprocess.run(command, capture_output=True, text=True, timeout=30)
            try: response = json.loads(proc.stdout)
            except ValueError: raise RuntimeError('local dispatch acknowledgement unavailable')
            if proc.returncode or not response.get('id'):
                raise RuntimeError('local dispatch acknowledgement unavailable')
        elif local:
            command = [cli,'lane','assign',lane,'--prompt',prompt,'--base',base,
                       '--budget-minutes',str(args.budget_minutes)]
            if args.title: command += ['--title', args.title]
            if args.verify: command += ['--verify',args.verify]
            if read_only: command.append('--read-only')
            proc = subprocess.run(command, capture_output=True, text=True, timeout=30)
            try: response = json.loads(proc.stdout)
            except ValueError: raise RuntimeError('local dispatch acknowledgement unavailable')
            if response.get('ok') is False:
                if response.get('error') == f'lane {lane} is busy (busy)':
                    continue
                raise RuntimeError('local dispatch acknowledgement unavailable')
            if proc.returncode or not response.get('id'):
                raise RuntimeError('local dispatch acknowledgement unavailable')
        else:
            try:
                request = {'op':'assign','lane':lane,'prompt':prompt,'base':base,
                           'title':args.title,'verify':args.verify,'budget_minutes':args.budget_minutes,
                           'read_only':read_only}
                source = row['_remote_source']
                response = remote(request) if source == DEFAULT_REMOTE_SOURCE else remote_from(source, request)
            except LaneBusy:
                continue
        result.update({'id':response['id'], 'state':response['state']})
        print(json.dumps(result)); return
    raise RuntimeError('available lanes changed or rejected the task')

if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as e:
        print(json.dumps({'ok':False,'error':str(e)})); sys.exit(1)
