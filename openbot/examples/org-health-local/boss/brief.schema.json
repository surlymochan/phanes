{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openbot:examples:org-health-local:brief.schema.json",
  "title": "组织诊断任务书",
  "description": "brief.json 的结构定义：Boss 产出的任务书，只含口径、问题与字段映射，不含真实组织数据或真实数字。口径的键与 data/diagnosis.json 的 metrics 标题一一对应。",
  "$comment": "字段路径是逻辑路径：数据提供方的原始表与列名由 DA 按实际来源映射。",
  "type": "object",
  "additionalProperties": false,
  "required": ["period", "summary", "目标", "观察期间", "口径", "必答问题", "数据需求", "禁止事项", "schema版本"],
  "properties": {
    "period": {
      "description": "观察月份，格式 YYYY-MM。",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "summary": {
      "description": "本次组织健康诊断的非空摘要。",
      "type": "string",
      "minLength": 1
    },
    "目标": {
      "description": "本次诊断要回答的问题，1-5 条。",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "观察期间": {
      "$ref": "#/$defs/观察期间"
    },
    "口径": {
      "$ref": "#/$defs/口径"
    },
    "必答问题": {
      "description": "DA 必须逐条回答的问题。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "数据需求": {
      "description": "要从真实数据文件读取的字段路径与口径映射。",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/数据需求"
      }
    },
    "禁止事项": {
      "description": "取数与写结论时的禁止项。至少含“不得写入真实组织数据”与“不作个人/薪酬/编制判断”。",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema版本": {
      "description": "任务书结构版本，与诊断快照的 schema 版本一致，固定为 4。",
      "const": 4
    }
  },
  "$defs": {
    "观察期间": {
      "description": "期间口径，与 scope 的“观察月份”“数据截止”对齐。",
      "type": "object",
      "additionalProperties": false,
      "required": ["观察月份", "数据截止", "期次", "说明"],
      "properties": {
        "观察月份": {
          "description": "观察月份，格式 YYYY-MM。",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "数据截止": {
          "description": "数据截止日期，格式 YYYY-MM-DD。",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "期次": {
          "description": "期次锚点，键名与站点数值序列一致。",
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "说明": {
          "type": "string",
          "minLength": 1
        },
        "起始期次": {
          "type": "string",
          "minLength": 1
        },
        "参考期次": {
          "type": "string",
          "minLength": 1
        },
        "截止期次": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "口径": {
      "description": "每个数字的口径定义，键与示例 metrics 的标题一一对应。",
      "type": "object",
      "additionalProperties": false,
      "required": ["整体技术人力成本", "整体折算人头", "营收业务（含共享平台）技术人力成本与折算人头", "收入与成本率"],
      "properties": {
        "整体技术人力成本": {
          "$ref": "#/$defs/口径项"
        },
        "整体折算人头": {
          "$ref": "#/$defs/口径项"
        },
        "营收业务（含共享平台）技术人力成本与折算人头": {
          "$ref": "#/$defs/口径项"
        },
        "收入与成本率": {
          "$ref": "#/$defs/口径项"
        },
        "汇率": {
          "description": "人民币/美元，表示每美元折合人民币数。",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "口径项": {
      "description": "一个指标的口径：单位、定义、期间与缺失处理。",
      "type": "object",
      "additionalProperties": false,
      "required": ["单位", "定义", "期间", "缺失处理"],
      "properties": {
        "单位": {
          "type": "string",
          "minLength": 1
        },
        "定义": {
          "type": "string",
          "minLength": 1
        },
        "期间": {
          "type": "string",
          "minLength": 1
        },
        "缺失处理": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "数据需求": {
      "description": "一条数据需求：逻辑字段路径、单位、口径与对应指标。",
      "type": "object",
      "additionalProperties": false,
      "required": ["字段路径", "单位", "口径", "对应指标"],
      "properties": {
        "字段路径": {
          "type": "string",
          "minLength": 1
        },
        "单位": {
          "type": "string",
          "minLength": 1
        },
        "口径": {
          "type": "string",
          "minLength": 1
        },
        "对应指标": {
          "description": "该字段供给的指标标题，必须是站点期望的四个标题之一。",
          "type": "string",
          "enum": ["整体技术人力成本", "整体折算人头", "营收业务（含共享平台）技术人力成本与折算人头", "收入与成本率"]
        }
      }
    }
  }
}
