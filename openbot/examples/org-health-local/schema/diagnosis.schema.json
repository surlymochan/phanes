{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openbot:examples:org-health-local:diagnosis.schema.json",
  "title": "组织健康诊断快照",
  "description": "diagnosis.json 的结构定义。字段与 app.js 读取的字段一致：scope 给出口径与 schema版本，metrics 按页面顺序给出四个指标。",
  "$comment": "指标标题与页面 expected 数组一致；series 键名是页面按名读取的锚点。",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "scope", "conclusion", "origin", "metrics", "insights", "definitions", "risks", "recommendations"],
  "properties": {
    "synthetic": {
      "const": true,
      "description": "标记该快照为合成数据。"
    },
    "口径说明": {
      "description": "可选：数据口径说明面板（期间、单位、年末测算与 H1 参考、null 含义），见 #55。",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "facts": {
      "description": "可选的事实来源快照；insights/recommendations 中的数字引用必须能按期间回溯到此对象或 series/metrics。",
      "type": "object",
      "additionalProperties": true
    },
    "series": {
      "description": "可选的期间序列来源快照；insights/recommendations 中的数字引用必须能按期间回溯到同值指标。",
      "type": "object",
      "additionalProperties": true
    },
    "insights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/insight"
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "stage": {
      "$ref": "#/$defs/stage"
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["数据截止", "观察月份", "来源", "schema版本"],
      "properties": {
        "数据截止": {
          "description": "数据截止日期。",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "观察月份": {
          "description": "观察月份，格式 YYYY-MM。",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "来源": {
          "type": "string",
          "minLength": 1
        },
        "schema版本": {
          "description": "结构版本，页面只接受 4。",
          "const": 4
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/metricOverallCost"
        },
        {
          "$ref": "#/$defs/metricOverallHeads"
        },
        {
          "$ref": "#/$defs/metricRevenueOps"
        },
        {
          "$ref": "#/$defs/metricIncome"
        }
      ]
    },
    "metricOverallCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["标题", "数值"],
      "properties": {
        "标题": {
          "const": "整体技术人力成本"
        },
        "数值": {
          "$ref": "#/$defs/actualSeries"
        }
      }
    },
    "metricOverallHeads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["标题", "数值"],
      "properties": {
        "标题": {
          "const": "整体折算人头"
        },
        "数值": {
          "$ref": "#/$defs/actualSeries"
        }
      }
    },
    "metricRevenueOps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["标题", "数值"],
      "properties": {
        "标题": {
          "const": "营收业务（含共享平台）技术人力成本与折算人头"
        },
        "数值": {
          "type": "object",
          "additionalProperties": false,
          "required": ["成本", "折算人头"],
          "properties": {
            "成本": {
              "$ref": "#/$defs/series"
            },
            "折算人头": {
              "$ref": "#/$defs/series"
            }
          }
        }
      }
    },
    "metricIncome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["标题", "数值"],
      "properties": {
        "标题": {
          "const": "收入与成本率"
        },
        "数值": {
          "type": "object",
          "additionalProperties": false,
          "required": ["收入万美元每月", "整体技术人力成本率", "营收业务技术人力成本率", "全口径技术成本率含运维设施"],
          "properties": {
            "收入万美元每月": {
              "$ref": "#/$defs/revenueSeries"
            },
            "整体技术人力成本率": {
              "$ref": "#/$defs/ratioSeries"
            },
            "营收业务技术人力成本率": {
              "$ref": "#/$defs/ratioSeries"
            },
            "全口径技术成本率含运维设施": {
              "$ref": "#/$defs/fullRateSeries"
            }
          }
        }
      }
    },
    "actualSeries": {
      "description": "整体口径的数值序列。2026-05H1参考 是明确的不可用锚点，必须为 null。",
      "type": "object",
      "required": ["2026-01实际", "2026-05H1参考", "2026-09实际", "年末测算"],
      "properties": {
        "2026-05H1参考": {
          "type": "null"
        }
      },
      "additionalProperties": {
        "type": ["number", "null"]
      }
    },
    "series": {
      "description": "数值序列。缺失的期间用 null 表示。",
      "type": "object",
      "required": ["2026-01实际", "2026-05H1参考", "2026-09实际", "年末测算"],
      "additionalProperties": {
        "type": ["number", "null"]
      }
    },
    "revenueSeries": {
      "description": "收入序列，页面读取年末目标作为预测锚点。",
      "type": "object",
      "required": ["2026-01实际", "2026-05H1参考", "2026-09实际", "年末目标"],
      "additionalProperties": {
        "type": ["number", "null"]
      }
    },
    "ratioSeries": {
      "description": "比率序列。页面按原文显示比率，所以允许字符串。",
      "type": "object",
      "required": ["2026-01实际", "2026-09实际"],
      "additionalProperties": {
        "type": ["number", "null", "string"]
      }
    },
    "fullRateSeries": {
      "description": "全口径成本率序列，键名带整体前缀。",
      "type": "object",
      "required": ["整体2026-01实际", "整体2026-09实际"],
      "additionalProperties": {
        "type": ["number", "null", "string"]
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["类型", "标题", "内容"],
      "properties": {
        "类型": {
          "type": "string",
          "minLength": 1
        },
        "标题": {
          "type": "string",
          "minLength": 1
        },
        "内容": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["标题", "内容"],
      "properties": {
        "标题": {
          "type": "string",
          "minLength": 1
        },
        "内容": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["优先级", "标题", "依据", "缺失证据", "验证方式"],
      "properties": {
        "优先级": {
          "type": "string",
          "minLength": 1
        },
        "标题": {
          "type": "string",
          "minLength": 1
        },
        "依据": {
          "type": "string",
          "minLength": 1
        },
        "缺失证据": {
          "type": "string",
          "minLength": 1
        },
        "验证方式": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "description": "可选的分档区块。页面在存在时渲染该区块。",
      "type": "object",
      "additionalProperties": false,
      "required": ["标题", "来源口径", "指标"],
      "properties": {
        "标题": {
          "type": "string",
          "minLength": 1
        },
        "来源口径": {
          "type": "string",
          "minLength": 1
        },
        "指标": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["分档", "例证"],
            "properties": {
              "分档": {
                "type": "string",
                "minLength": 1
              },
              "例证": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
