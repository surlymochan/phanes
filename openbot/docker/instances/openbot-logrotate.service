# Rotates the container logs of the OpenBot instances. openbot-logrotate.timer starts it.
# `openbot-instance setup` installs it. See docs/docker.md#logs.
[Unit]
Description=Rotate the container logs of the OpenBot instances

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate --state /var/lib/logrotate/openbot-docker.status /etc/openbot-docker/logrotate.conf
