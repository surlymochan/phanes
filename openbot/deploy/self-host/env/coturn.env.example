# The environment of the TURN service (coturn).
#
# Copy this file to /etc/openbot/coturn.env, fill in the values, and keep it out of the
# repository. The file holds a secret. The Git rule `deploy/self-host/env/*.env` ignores a copy
# that stays in the repository.
#
#   sudo install -d -m 0750 -o root -g turnserver /etc/openbot
#   sudo install -m 0640 -o root -g turnserver deploy/self-host/env/coturn.env.example \
#     /etc/openbot/coturn.env
#   sudoedit /etc/openbot/coturn.env

# The secret of the TURN credentials. The Signal service uses the same value. The value must
# have at least 32 bytes.
TURN_SHARED_SECRET=replace-with-a-random-value-of-48-bytes

# The realm and the name of the TURN service. The clients use this name.
TURN_REALM=turn.example.com

# The public address of this host. Leave the value empty when the host has its own public
# address. The script puts the value in the configuration as `external-ip`.
TURN_PUBLIC_IP=203.0.113.10

# The domain of the certificate of Caddy. The script copies that certificate into the runtime
# directory of coturn.
TURN_CERTIFICATE_DOMAIN=turn.example.com

# The directory with the certificates of Caddy. Do not change it.
CADDY_CERTIFICATE_ROOT=/var/lib/caddy/certificates
