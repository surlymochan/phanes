# The environment of the Signal service (remote/api).
#
# Copy this file to /etc/openbot/signal.env, fill in the values, and keep it out of the
# repository. The file holds secrets. The Git rule `deploy/self-host/env/*.env` ignores a copy
# that stays in the repository.
#
#   sudo install -d -m 0750 -o root -g openbot /etc/openbot
#   sudo install -m 0640 -o root -g openbot deploy/self-host/env/signal.env.example \
#     /etc/openbot/signal.env
#   sudoedit /etc/openbot/signal.env
#
# Make each secret with `openssl rand -base64 48`. The value must have at least 32 bytes.

# The service listens on the loopback address. Caddy ends the TLS.
REMOTE_SIGNAL_HOST=127.0.0.1
REMOTE_SIGNAL_PORT=8081
REMOTE_TLS_DISABLED=true

# The health port. It holds the health routes and the metrics, and it stays on the loopback
# address.
REMOTE_HEALTH_PORT=8080

# The account service. Its JWKS holds the public key of the ticket key pair.
REMOTE_TICKET_JWKS_URL=https://api.example.com/.well-known/jwks.json
REMOTE_CONTROL_PLANE_URL=https://api.example.com

# The secret of the session tokens of the service. Make a new value for each deployment.
REMOTE_SESSION_SECRET=replace-with-a-random-value-of-48-bytes

# The secret of the account events. The account service uses the same value.
REMOTE_AUTH_WEBHOOK_SECRET=replace-with-a-random-value-of-48-bytes

# The secret of the TURN credentials. The TURN service uses the same value.
TURN_SHARED_SECRET=replace-with-a-random-value-of-48-bytes

# The TURN service. The clients use this name and these ports.
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349

# The token of the metrics. The metrics stay on the health port.
REMOTE_METRICS_TOKEN=replace-with-a-random-value-of-48-bytes

# The limits of the connections and of the messages.
REMOTE_MAX_CONNECTIONS_PER_USER=32
REMOTE_MAX_CONNECTIONS_PER_IP=32
REMOTE_MAX_MESSAGES_PER_MINUTE=600

# Caddy is the only client of the service, so the address in X-Forwarded-For is the address of
# the client. The service uses it for the limit of the connections.
REMOTE_TRUST_PROXY=true

# The commit of the release. The health route shows it.
OPENBOT_SOURCE_COMMIT=unknown
