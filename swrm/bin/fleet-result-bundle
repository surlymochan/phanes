#!/usr/bin/env python3
"""Return a completed run's Git branch and versioned raw evidence as a bundle.

Evidence comes only from result.result receipt fields; unavailable is not a
pass. This transports recorded values, not a fresh CI check or review verdict.
Unknown fields are not promoted into evidence. Logs are UTF-8, capped at 64 KiB.
"""
import base64
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

MAX_LOG_BYTES = 64 * 1024


def raw_evidence(raw):
    """Normalize known receipt shapes without interpreting outcomes or commands."""
    raw = raw if isinstance(raw, dict) else {}
    evidence = {"version": 1, **{name: {"status": "unavailable"}
                for name in ("ci", "tests", "diff", "acceptance")}}
    ci = raw.get("ci")
    if isinstance(ci, dict) and isinstance(ci.get("conclusion"), str) and ci["conclusion"]:
        evidence["ci"] = {"status": "available", "conclusion": ci["conclusion"]}
        if isinstance(ci.get("url"), str):
            evidence["ci"]["url"] = ci["url"]
    tests = raw.get("tests")
    if (isinstance(tests, dict) and isinstance(tests.get("command"), str)
            and tests["command"] and type(tests.get("rc")) is int
            and isinstance(tests.get("log"), str)):
        encoded = tests["log"].encode("utf-8", errors="replace")
        evidence["tests"] = {"status": "available", "command": tests["command"],
                             "rc": tests["rc"],
                             "log": encoded[:MAX_LOG_BYTES].decode("utf-8", errors="ignore"),
                             "truncated": len(encoded) > MAX_LOG_BYTES}
    diff = raw.get("diff")
    counts = ("files_changed", "insertions", "deletions")
    if isinstance(diff, dict) and all(type(diff.get(key)) is int and diff[key] >= 0
                                      for key in counts):
        evidence["diff"] = {"status": "available", **{key: diff[key] for key in counts}}
    acceptance = raw.get("acceptance")
    fields = ("item", "result", "detail")
    if isinstance(acceptance, list) and acceptance and all(
            isinstance(item, dict) and all(isinstance(item.get(key), str) for key in fields)
            and item["item"] and item["result"] for item in acceptance):
        evidence["acceptance"] = {"status": "available", "items": [
            {key: item[key] for key in fields} for item in acceptance]}
    return evidence


try:
    info = json.load(sys.stdin)
    run_id = info['id']
    result = info['result']
    branch, commit = result['branch'], result['commit']
    repo = result['workspace']['repo']
    base = result['workspace']['base']
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,99}', run_id) or branch != 'swrm/' + run_id:
        raise ValueError('run has no matching branch')
    if not re.fullmatch(r'[0-9a-f]{40,64}', commit) or not re.fullmatch(r'[0-9a-f]{40,64}', base) or not Path(repo).is_dir():
        raise ValueError('run has no completed commit')
    actual = subprocess.check_output(['git', '-C', repo, 'rev-parse', 'refs/heads/' + branch], text=True).strip()
    if actual != commit:
        raise ValueError('run branch does not match its recorded commit')
    with tempfile.TemporaryDirectory(prefix='swrm-result-') as directory:
        bundle = Path(directory) / 'result.bundle'
        subprocess.run(['git', '-C', repo, 'bundle', 'create', str(bundle), 'refs/heads/' + branch, '^' + base],
                       check=True, capture_output=True, timeout=120)
        encoded = base64.b64encode(bundle.read_bytes()).decode('ascii')
    raw = result.get('result')
    output = {'branch': branch, 'commit': commit, 'bundle': encoded,
              'evidence': raw_evidence(raw)}
    if isinstance(raw, dict) and isinstance(raw.get('opinion'), str):
        output['reference_opinion'] = raw['opinion']
    print(json.dumps(output))
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
    print(json.dumps({'error': str(error)[:200]}))
    sys.exit(1)
