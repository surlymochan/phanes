{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openflow/schemas/evalid-artifact.schema.json",
  "title": "EValid Public Artifact Envelope",
  "description": "Public envelope of one evalid role stage. The oneOf branches separate the Spec, TDD and Review payloads; every branch pins kind, role and stage together, so a role can never run a stage it is not allowed to run. Every object closes extra fields. All digests are content addresses (sha256:<64 lowercase hex>), all commits are full Git OIDs. evidence_id is the sha256 of the canonical JSON of the envelope without the evidence_id field itself (see src/core/workflow-integrity.js for the canonical ordering). Hidden holdout material never belongs in a public envelope: only the control plane stores it, and it is reported to the lanes as a sanitized receipt (see the holdout_receipt definition).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "role",
    "stage",
    "change_id",
    "attempt",
    "run_id",
    "issue_ref",
    "base_commit",
    "head_commit",
    "parents",
    "producer",
    "artifacts",
    "payload",
    "evidence_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "type": "string", "enum": ["spec", "tdd", "review"] },
    "role": { "type": "string", "enum": ["evalid-spec", "evalid-tdd", "evalid-review"] },
    "stage": { "type": "string", "enum": ["spec", "red", "green", "spec-check", "delivery"] },
    "change_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "attempt": { "type": "integer", "minimum": 0 },
    "run_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "issue_ref": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "base_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "head_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "parents": {
      "description": "Content addresses of the already accepted parent evidence of the same change. Resolving them to received evidence, and refusing a parent cycle, is the job of the control plane; this schema only fixes the shape.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/content_address" }
    },
    "producer": { "$ref": "#/definitions/producer" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifact_entry" }
    },
    "payload": { "type": "object" },
    "evidence_id": { "$ref": "#/definitions/content_address" }
  },
  "propertyNames": { "$ref": "#/definitions/public_property_name" },
  "oneOf": [
    { "$ref": "#/definitions/envelope_spec" },
    { "$ref": "#/definitions/envelope_tdd" },
    { "$ref": "#/definitions/envelope_review" }
  ],
  "definitions": {
    "content_address": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "logical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "repo_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "scope_path": {
      "description": "Repository relative path of the change scope. Glob metacharacters are allowed, absolute paths and path traversal are not.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._*?{}\\[\\]-]+(?:/[A-Za-z0-9._*?{}\\[\\]-]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "public_property_name": {
      "description": "Public envelopes never carry hidden holdout material. Names that look like private control plane state are refused even where the surrounding object would allow them.",
      "not": {
        "type": "string",
        "pattern": "^(?:hidden|secret|private|internal|control_plane|reference_impl|holdout_(?!receipt$))"
      }
    },
    "producer": {
      "type": "object",
      "description": "Actual run receipt of the producing model run, not the declaration on the card.",
      "additionalProperties": false,
      "required": ["backend", "model", "effort", "policy_digest", "tool_commit"],
      "properties": {
        "backend": { "$ref": "#/definitions/text" },
        "model": { "$ref": "#/definitions/text" },
        "effort": {
          "anyOf": [
            { "type": "string", "enum": ["low", "medium", "high"] },
            { "type": "null" }
          ]
        },
        "policy_digest": { "$ref": "#/definitions/content_address" },
        "tool_commit": { "$ref": "#/definitions/git_oid" }
      },
      "allOf": [
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["backend"],
            "properties": { "backend": { "const": "codex" } }
          },
          "then": {
            "type": "object",
            "properties": {
              "effort": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        }
      ]
    },
    "artifact_entry": {
      "type": "object",
      "description": "One produced artifact. The name is a logical name without path traversal; the digest covers the raw bytes and must not follow external symbolic links.",
      "additionalProperties": false,
      "required": ["name", "sha256", "media_type"],
      "properties": {
        "name": { "$ref": "#/definitions/logical_name" },
        "sha256": { "$ref": "#/definitions/content_address" },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        }
      }
    },
    "spec_assertion": {
      "type": "object",
      "description": "One observable assertion of a scenario. A scenario never ends in a conclusion such as \"works as expected\".",
      "additionalProperties": false,
      "required": ["channel", "operator", "expected"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["exit", "stdout", "stderr", "json", "file"]
        },
        "operator": {
          "type": "string",
          "enum": ["eq", "contains", "absent", "schema"]
        },
        "expected": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" },
            { "type": "array", "minItems": 1 },
            { "type": "object", "minProperties": 1 }
          ]
        },
        "selector": { "$ref": "#/definitions/text" }
      },
      "allOf": [
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["channel"],
            "properties": { "channel": { "enum": ["json", "file"] } }
          },
          "then": {
            "type": "object",
            "required": ["selector"],
            "properties": { "selector": { "$ref": "#/definitions/text" } }
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["operator"],
            "properties": { "operator": { "const": "absent" } }
          },
          "then": {
            "type": "object",
            "properties": { "expected": { "type": "null" } }
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["operator"],
            "properties": { "operator": { "const": "schema" } }
          },
          "then": {
            "type": "object",
            "properties": { "expected": { "$ref": "#/definitions/content_address" } }
          }
        }
      ]
    },
    "spec_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ref", "given", "when", "then", "command_id"],
      "properties": {
        "id": { "$ref": "#/definitions/logical_name" },
        "requirement_ref": { "$ref": "#/definitions/text" },
        "given": { "$ref": "#/definitions/text" },
        "when": { "$ref": "#/definitions/text" },
        "then": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/spec_assertion" }
        },
        "command_id": { "$ref": "#/definitions/text" }
      }
    },
    "spec_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "cwd", "expected_exit", "timeout_s", "environment_digest"],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "$ref": "#/definitions/repo_relative_path" },
        "expected_exit": { "type": "integer" },
        "timeout_s": { "type": "integer", "minimum": 1 },
        "environment_digest": { "$ref": "#/definitions/content_address" }
      }
    },
    "spec_payload": {
      "type": "object",
      "title": "spec.json",
      "additionalProperties": false,
      "required": ["spec_version", "scope", "scenarios", "commands"],
      "properties": {
        "spec_version": { "type": "integer", "minimum": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_files", "excluded_files"],
          "properties": {
            "allowed_files": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/scope_path" }
            },
            "excluded_files": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/scope_path" }
            }
          }
        },
        "scenarios": {
          "description": "Public scenarios of the change. Identifiers are unique and every scenario resolves to a command and to a public requirement; the spec stage checks that coverage.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/spec_scenario" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/spec_command" }
        },
        "tdd_mode": {
          "description": "Default is red-green. The docs and refactor modes are exceptions that the intake freezes and the spec check confirms.",
          "type": "string",
          "enum": ["red-green", "refactor", "docs"],
          "default": "red-green"
        }
      },
      "propertyNames": { "$ref": "#/definitions/public_property_name" }
    },
    "proof_ref": {
      "type": "object",
      "description": "Reference to an existing I6a/I6b proof or to the snapshot bound to it.",
      "additionalProperties": false,
      "required": ["kind", "phase", "artifact_ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["proof", "snapshot"] },
        "phase": { "type": "string", "enum": ["red", "green"] },
        "artifact_ref": { "$ref": "#/definitions/content_address" },
        "path": { "$ref": "#/definitions/logical_name" }
      }
    },
    "gate_result": {
      "type": "object",
      "description": "One executed public gate command with its real exit code and the digest of its report. \"tests passed\" is not a gate result.",
      "additionalProperties": false,
      "required": ["command", "exit_code", "report_digest"],
      "properties": {
        "command": { "$ref": "#/definitions/text" },
        "exit_code": { "type": "integer" },
        "report_digest": { "$ref": "#/definitions/content_address" }
      }
    },
    "tdd_payload": {
      "type": "object",
      "title": "tdd.json",
      "additionalProperties": false,
      "required": [
        "spec_digest",
        "phase",
        "source_commit",
        "test_manifest",
        "proof_refs",
        "scenario_tests",
        "gate_results"
      ],
      "properties": {
        "spec_digest": { "$ref": "#/definitions/content_address" },
        "phase": { "type": "string", "enum": ["red", "green"] },
        "source_commit": { "$ref": "#/definitions/git_oid" },
        "test_manifest": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/definitions/logical_name" },
          "additionalProperties": { "$ref": "#/definitions/content_address" }
        },
        "proof_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/proof_ref" }
        },
        "scenario_tests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/definitions/logical_name" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/gate_result" }
        }
      },
      "propertyNames": { "$ref": "#/definitions/public_property_name" }
    },
    "spec_check_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "requirement_ref", "artifact_ref", "reason"],
      "properties": {
        "severity": { "type": "string", "enum": ["BLOCKER", "FOLLOW-UP"] },
        "requirement_ref": { "$ref": "#/definitions/text" },
        "artifact_ref": { "$ref": "#/definitions/text" },
        "reason": { "$ref": "#/definitions/text" }
      }
    },
    "delivery_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "requirement_ref", "artifact_ref", "reason", "path", "line"],
      "properties": {
        "severity": { "type": "string", "enum": ["BLOCKER", "FOLLOW-UP"] },
        "requirement_ref": { "$ref": "#/definitions/text" },
        "artifact_ref": { "$ref": "#/definitions/text" },
        "reason": { "$ref": "#/definitions/text" },
        "path": {
          "anyOf": [
            { "$ref": "#/definitions/logical_name" },
            { "type": "null" }
          ]
        },
        "line": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "spec_check_payload": {
      "type": "object",
      "title": "review.json of the spec-check stage",
      "additionalProperties": false,
      "required": ["subject", "verdict", "findings"],
      "properties": {
        "subject": { "$ref": "#/definitions/content_address" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NEEDS-BOSS"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/spec_check_finding" }
        }
      },
      "propertyNames": { "$ref": "#/definitions/public_property_name" },
      "allOf": [
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["verdict"],
            "properties": { "verdict": { "const": "PASS" } }
          },
          "then": {
            "type": "object",
            "properties": {
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": { "not": { "const": "BLOCKER" } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "delivery_payload": {
      "type": "object",
      "title": "review.json of the delivery stage",
      "additionalProperties": false,
      "required": [
        "spec_digest",
        "tdd_digest",
        "reviewed_base",
        "reviewed_head",
        "commits",
        "verdict",
        "findings",
        "holdout_receipt"
      ],
      "properties": {
        "spec_digest": { "$ref": "#/definitions/content_address" },
        "tdd_digest": { "$ref": "#/definitions/content_address" },
        "reviewed_base": { "$ref": "#/definitions/git_oid" },
        "reviewed_head": { "$ref": "#/definitions/git_oid" },
        "commits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/git_oid" }
        },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NEEDS-BOSS"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/delivery_finding" }
        },
        "holdout_receipt": { "$ref": "#/definitions/content_address" }
      },
      "propertyNames": { "$ref": "#/definitions/public_property_name" },
      "allOf": [
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["verdict"],
            "properties": { "verdict": { "const": "PASS" } }
          },
          "then": {
            "type": "object",
            "properties": {
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": { "not": { "const": "BLOCKER" } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "envelope_spec": {
      "type": "object",
      "required": ["kind", "role", "stage", "payload"],
      "properties": {
        "kind": { "const": "spec" },
        "role": { "const": "evalid-spec" },
        "stage": { "const": "spec" },
        "payload": { "$ref": "#/definitions/spec_payload" }
      }
    },
    "envelope_tdd": {
      "type": "object",
      "required": ["kind", "role", "stage", "payload"],
      "properties": {
        "kind": { "const": "tdd" },
        "role": { "const": "evalid-tdd" },
        "stage": { "enum": ["red", "green"] },
        "payload": { "$ref": "#/definitions/tdd_payload" }
      }
    },
    "envelope_review": {
      "type": "object",
      "required": ["kind", "role", "stage", "payload"],
      "properties": {
        "kind": { "const": "review" },
        "role": { "const": "evalid-review" },
        "stage": { "enum": ["spec-check", "delivery"] }
      },
      "allOf": [
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["stage"],
            "properties": { "stage": { "const": "spec-check" } }
          },
          "then": {
            "type": "object",
            "properties": { "payload": { "$ref": "#/definitions/spec_check_payload" } }
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": ["stage"],
            "properties": { "stage": { "const": "delivery" } }
          },
          "then": {
            "type": "object",
            "properties": { "payload": { "$ref": "#/definitions/delivery_payload" } }
          }
        }
      ]
    },
    "holdout_receipt": {
      "type": "object",
      "title": "Control plane holdout receipt",
      "description": "Sanitized receipt of the control plane holdout run. Defined in the same schema version as the public envelope but validated separately: it never travels to a lane, and it never carries the hidden suite, the failing samples, the commands, the logs or the internal locations.",
      "additionalProperties": false,
      "required": [
        "change_id",
        "attempt",
        "subject_head",
        "spec_digest",
        "suite_digest",
        "required",
        "status",
        "isolation",
        "l1_eligible",
        "evidence_digest"
      ],
      "properties": {
        "change_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "attempt": { "type": "integer", "minimum": 0 },
        "subject_head": { "$ref": "#/definitions/git_oid" },
        "spec_digest": { "$ref": "#/definitions/content_address" },
        "suite_digest": { "$ref": "#/definitions/content_address" },
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INFRA", "NOT_APPLICABLE"]
        },
        "isolation": {
          "type": "string",
          "enum": ["verified", "unisolated", "unknown"]
        },
        "l1_eligible": { "type": "boolean" },
        "evidence_digest": { "$ref": "#/definitions/content_address" }
      }
    }
  }
}
